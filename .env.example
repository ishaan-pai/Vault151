# Copy to .env and fill in real values. .env is gitignored; this file is not.

# --- Database (Oracle) ---
ORACLE_PASSWORD=change-me-admin        # SYS/SYSTEM password for the container
APP_USER=cardshop                      # schema that owns all app tables
APP_USER_PASSWORD=change-me-app        # letters and digits only (no @ / " characters)
DB_HOST=localhost                      # "localhost" locally; TMU/EC2/RDS host otherwise
DB_PORT=1521
DB_SERVICE=FREEPDB1                    # Oracle service name (FREEPDB1 for the Docker image)
