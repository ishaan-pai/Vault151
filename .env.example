# Copy to .env and fill in real values. .env is gitignored; this file is not.
#
# Comments must sit on their own line. The backend container reads this file with
# Docker Compose's raw format, which takes everything after the "=" literally - so an
# inline "# comment" would become part of the value. Raw format is what lets the
# argon2 hash keep its $ characters instead of being eaten as variable substitutions.

# --- Database (Oracle) ---
# SYS/SYSTEM password for the container
ORACLE_PASSWORD=change-me-admin
# schema that owns all app tables
APP_USER=cardshop
# letters and digits only (no @ / " characters)
APP_USER_PASSWORD=change-me-app
# "localhost" locally; TMU/EC2/RDS host otherwise
DB_HOST=localhost
DB_PORT=1521
# Oracle service name (FREEPDB1 for the Docker image)
DB_SERVICE=FREEPDB1

# --- Backend ---
# "dev" or "prod"; dev enables /docs and plain logs
APP_ENV=dev
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# host port the API is published on
BACKEND_PORT=8000
# connections opened when the pool starts
DB_POOL_MIN=1
# ceiling; Oracle Free limits sessions
DB_POOL_MAX=5
# connections added when the pool grows
DB_POOL_INCREMENT=1

# --- Catalogue API ---
# cards per page when the client doesn't say
DEFAULT_PAGE_SIZE=12
# cards in the home page feature strip
FEATURED_COUNT=4
# dev servers; narrow in prod
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
# host port the site is published on
FRONTEND_PORT=8080
# VITE_API_BASE_URL is intentionally unset: in dev Vite proxies /api, and in the
# container nginx does. Set it only if the API moves to another host.

# --- Checkout ---
# how long an unpaid order holds its cards
RESERVATION_MINUTES=30
# flat rate within Canada, CAD
SHIPPING_FEE_CA=15.00
# flat rate to the United States, CAD
SHIPPING_FEE_US=30.00

# --- Seller admin ---
ADMIN_USERNAME=seller
# Generate with: cd backend && uv run python scripts/hash_password.py
ADMIN_PASSWORD_HASH=change-me-argon2-hash
# Signs the session cookie. At least 32 characters, or the backend refuses to start:
# a short secret can be brute-forced and used to forge a login. Changing it signs
# everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_JWT_SECRET=change-me-at-least-32-characters-long
# where uploaded card photos are written
MEDIA_DIR=/srv/media
# 5 MB per photo
MAX_UPLOAD_BYTES=5000000
